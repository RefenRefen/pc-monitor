<Window
    x:Class="PcMonitor.Widget.CompactWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PC Monitor">

    <Border x:Name="Frame"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#2EFFFFFF"
            Background="Transparent"
            RequestedTheme="Dark">
        <Grid x:Name="Root" Padding="14,10,14,10" Background="Transparent">
            <Grid.ContextFlyout>
                <MenuFlyout x:Name="Menu">
                    <MenuFlyoutItem x:Name="OpenItem" Text="Open dashboard" Click="OnOpenDashboard">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="TopItem" Text="Always on top" Click="OnToggleTop" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Hide widget" Click="OnHide">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Exit PC Monitor" Click="OnExit">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Height="26">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF5EE6A8" />
                    <TextBlock Text="PC Monitor" FontSize="12" FontWeight="SemiBold" Opacity="0.85" />
                </StackPanel>
                <Button x:Name="DashboardButton"
                        HorizontalAlignment="Right"
                        Padding="6,3"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnOpenDashboard"
                        ToolTipService.ToolTip="Open dashboard">
                    <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                </Button>
            </Grid>

            <StackPanel x:Name="Metrics" Grid.Row="1" Margin="0,2,0,0" />

            <Rectangle Grid.Row="2" Height="1" Fill="#22FFFFFF" Margin="0,8,0,6" />

            <TextBlock Grid.Row="3" Text="TOP APPS" FontSize="10" FontWeight="SemiBold" Opacity="0.55" Margin="0,0,0,2" />
            <StackPanel x:Name="Apps" Grid.Row="3" Margin="0,16,0,0" />

            <TextBlock x:Name="StatusText" Grid.Row="4" FontSize="10.5" Margin="0,4,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
